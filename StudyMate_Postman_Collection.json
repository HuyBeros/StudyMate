									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "4.2 Đổi trạng thái task (Done)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/tasks/{{taskId}}/status?status=DONE",
							"host": ["{{baseUrl}}"],
							"path": ["tasks", "{{taskId}}", "status"],
							"query": [
								{
									"key": "status",
									"value": "DONE"
								}
							]
						}
					}
				}
			]
		},
