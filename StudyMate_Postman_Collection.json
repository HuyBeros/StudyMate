						"body": {
							"mode": "raw",
							"raw": "{\n  \"subjectId\": {{subjectId}},\n  \"dayOfWeek\": \"THU_2\",\n  \"shift\": \"SANG\",\n  \"periods\": \"1-3\",\n  \"startTime\": \"07:00:00\",\n  \"endTime\": \"09:30:00\",\n  \"isOnline\": false,\n  \"isRecurring\": true,\n  \"teacherName\": \"TS. Nguyễn Văn A\",\n  \"room\": \"A2-301\"\n}"
