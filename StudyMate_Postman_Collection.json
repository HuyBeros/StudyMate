								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"subjectId\": {{subjectId}},\n  \"title\": \"Làm bài tập Spring Security JWT\",\n  \"description\": \"Tích hợp JWT và OAuth2 cho backend\",\n  \"deadline\": \"2026-08-05T23:59:00\",\n  \"status\": \"TODO\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/tasks",
							"host": ["{{baseUrl}}"],
							"path": ["tasks"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success) {",
