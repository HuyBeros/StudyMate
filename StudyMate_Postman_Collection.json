{
	"info": {
		"_postman_id": "studymate-api-collection-v1",
		"name": "StudyMate API Testing Suite",
		"description": "Bộ Test Case API đầy đủ cho StudyMate Backend (Auth, Subject, Schedule, Task, Note, Document, AI Gemini, Dashboard)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "refreshToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "subjectId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "noteId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "taskId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "quizId",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "01. Authentication",
			"item": [
				{
					"name": "1.1 Đăng ký tài khoản (Register)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user_test@gmail.com\",\n  \"password\": \"123456\",\n  \"fullName\": \"Học Sinh Demo\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success) {",
									"    pm.collectionVariables.set('token', jsonData.data.accessToken);",
									"    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
									"    console.log('AccessToken saved!');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "1.2 Đăng nhập (Login)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user_test@gmail.com\",\n  \"password\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success) {",
									"    pm.collectionVariables.set('token', jsonData.data.accessToken);",
									"    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
									"    console.log('AccessToken saved from Login!');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "1.3 Kiểm tra Token (Me)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "me"]
						}
					}
				},
				{
					"name": "1.4 Refresh Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/refresh",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "refresh"]
						}
					}
				}
			]
		},
		{
