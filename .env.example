# =====================================================
# StudyMate - Environment Variables Template
# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên Git
# =====================================================

# DATABASE
DB_URL=jdbc:postgresql://localhost:5432/studymate
DB_USERNAME=postgres
DB_PASSWORD=123456

# JWT
JWT_SECRET=change-this-to-a-random-256-bit-string-in-production

# GOOGLE OAUTH2 (lấy tại Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GEMINI AI (lấy tại https://ai.google.dev)
GEMINI_API_KEY=your-gemini-api-key

# UPLOAD
UPLOAD_DIR=uploads

# FRONTEND
FRONTEND_URL=http://localhost:5173
