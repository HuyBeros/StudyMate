# =====================================================
# StudyMate - Environment Variables Template
# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên Git
# =====================================================

# DATABASE
DB_URL=jdbc:postgresql://localhost:5432/studymate
DB_USERNAME=postgres
DB_PASSWORD=123456

# JWT
JWT_SECRET=change-this-to-a-random-256-bit-string-in-production

# GOOGLE OAUTH2 (lấy tại Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Optional: comma-separated allowlist, including web and Android OAuth client IDs
# GOOGLE_CLIENT_IDS=your-google-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GEMINI AI (lấy tại https://ai.google.dev)
GEMINI_API_KEY=your-gemini-api-key

# UPLOAD
UPLOAD_DIR=uploads

# FRONTEND
FRONTEND_URL=http://localhost:5173

# P1: timezone historically used by legacy task LocalDateTime columns.
# Must match SET studymate.legacy_timezone when applying migration_003.
STUDY_LEGACY_TIMEZONE=Asia/Ho_Chi_Minh
